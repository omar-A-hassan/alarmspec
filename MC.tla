---- MODULE MC ----
\* conformance.py makes this file from alarm.toml. Do not edit this file.
EXTENDS AlarmSystem, TLC

CONSTANTS h1, h2, m1, l1

MCConds      == {h1, h2, m1, l1}
MCPriority   == (h1 :> "HIGH") @@ (h2 :> "HIGH") @@ (m1 :> "MEDIUM") @@ (l1 :> "LOW")
MCLatching   == {h1, m1}
MCEscalating == {m1}
MCTimedEscalating == {l1}
MCIndex      == (h1 :> 0) @@ (h2 :> 1) @@ (m1 :> 2) @@ (l1 :> 3)
====
